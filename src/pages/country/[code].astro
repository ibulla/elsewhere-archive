---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryGrid from '../../components/EntryGrid.astro';
import { entries } from '../../lib/entries';
import { resolveCountry } from '../../lib/countries';
export function getStaticPaths() {
  return [...new Set(entries.map((entry) => entry.country))].map((code) => ({ params: { code }, props: { code } }));
}
const { code } = Astro.props;
const countryEntries = entries.filter((entry) => entry.country === code);
const country = resolveCountry(code);
---
<BaseLayout title={country.name}>
  <header class="page-heading">
    <h1>{country.name}</h1>
    <div class="heading-meta"><span class="eyebrow">Country / ISO 3166</span><span class="code">{country.alpha3} {country.numeric} / {countryEntries.length} {countryEntries.length === 1 ? 'entry' : 'entries'}</span></div>
  </header>
  <EntryGrid entries={countryEntries} />
</BaseLayout>
