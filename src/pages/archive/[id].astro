---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countryCode, entries, instagramUrl } from '../../lib/entries';
import { resolveCountry } from '../../lib/countries';
import type { Entry } from '../../types';

export function getStaticPaths() {
  return entries.map((entry, index) => ({ params: { id: entry.id }, props: { entry, index } }));
}
interface Props { entry: Entry; index: number; }
const { entry, index } = Astro.props;
const previous = entries[index - 1];
const next = entries[index + 1];
const country = resolveCountry(entry.country);
const references = [
  entry.references.web && { label: 'Web', url: entry.references.web },
  entry.references.instagram && { label: 'Instagram', url: instagramUrl(entry.references.instagram) },
  entry.references.facebook && { label: 'Facebook', url: entry.references.facebook }
].filter(Boolean) as { label: string; url: string }[];

// Registry notes intentionally support only a tiny, safe Markdown subset:
// *text* becomes <em>text</em>. Everything else remains plain text.
function registryNoteHtml(value: string) {
  const escaped = value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
  return escaped.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
}
---
<BaseLayout title={entry.id} description={`${entry.id}, a contribution by ${entry.contributor}.`}>
  <article class="record">
    <header class="record-heading">
      <h1>{countryCode(entry)}</h1>
      <div class="heading-meta"><span class="eyebrow">Registry entry</span><span aria-hidden="true">/</span><span class="archive-id">{entry.id}</span></div>
    </header>
    <figure class:list={['record-image', entry.visibility === 'pending' ? 'pending' : entry.orientation]}>
      {entry.visibility === 'pending' ? (
        <div class="pending-image pending-image-detail" aria-label={`Image pending registration for ${entry.id}`} role="img">
          <canvas class="pending-noise" aria-hidden="true"></canvas>
          <span class="pending-label">Image pending registration</span>
        </div>
      ) : (
        <img src={entry.image} alt={`Artwork for ${entry.id}`} />
      )}
    </figure>
    <dl class="registry-data">
      <div><dt>Archive ID</dt><dd class="archive-id">{entry.id}</dd></div>
      <div><dt>Edition</dt><dd><a href={`/edition/${entry.edition}`}>{entry.edition} / {entry.year}</a></dd></div>
      <div><dt>Country</dt><dd><a href={`/country/${country.alpha3}`}>{country.name}<br /><span class="code">{countryCode(entry)}</span></a></dd></div>
      <div><dt>Contributor</dt><dd>{entry.contributor}</dd></div>
      <div class="wide"><dt>Registry Note</dt><dd class="registry-note" set:html={registryNoteHtml(entry.registryNote)} /></div>
      <div><dt>Reference</dt><dd>{references.length ? references.map((reference, i) => <>{i > 0 && ' / '}<a class="external" href={reference.url} target="_blank" rel="noreferrer">{reference.label} ↗</a></>) : '—'}</dd></div>
      <div><dt>Registered At</dt><dd class="registered-at">{entry.registeredAt}</dd></div>
      <div><dt>Print Run</dt><dd>{entry.printRun}</dd></div>
    </dl>
    <nav class="record-nav" aria-label="Adjacent archive entries">
      <span>{previous ? <a href={`/archive/${previous.id}`}>← Previous<br /><b>{previous.id}</b></a> : 'Beginning of archive'}</span>
      <span>{next ? <a href={`/archive/${next.id}`}>Next →<br /><b>{next.id}</b></a> : 'End of archive'}</span>
    </nav>
  </article>

  {entry.visibility === 'pending' && (
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLCanvasElement>('.pending-noise').forEach((canvas) => {
        const context = canvas.getContext('2d', { alpha: false });
        if (!context) return;
        const render = () => {
          const width = Math.max(1, Math.floor(canvas.clientWidth / 4));
          const height = Math.max(1, Math.floor(canvas.clientHeight / 4));
          if (canvas.width !== width || canvas.height !== height) {
            canvas.width = width;
            canvas.height = height;
          }
          const frame = context.createImageData(width, height);
          for (let i = 0; i < frame.data.length; i += 4) {
            const value = 205 + Math.floor(Math.random() * 38);
            frame.data[i] = value;
            frame.data[i + 1] = value;
            frame.data[i + 2] = value;
            frame.data[i + 3] = 255;
          }
          context.putImageData(frame, 0, 0);
        };
        render();
        if (!reducedMotion) {
          const scheduleNext = () => {
            const delay = 1800 + Math.random() * 3200;
            window.setTimeout(() => {
              render();
              scheduleNext();
            }, delay);
          };
          window.setTimeout(scheduleNext, Math.random() * 1800);
        }
      });
    </script>
  )}
</BaseLayout>
