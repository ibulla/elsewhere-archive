---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryGrid from '../components/EntryGrid.astro';
import { countryCode, entries } from '../lib/entries';

const archiveEntries = entries.map((entry) => ({
  id: entry.id,
  image: entry.image,
  orientation: entry.orientation,
  contributor: entry.contributor,
  countryCode: countryCode(entry),
}));
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">A object made to travel.</p>
    <h1>ELSEWHERE</h1>
    <div class="hero-details">
      <p class="edition">Edition 01 / 2026</p>
      <p class="intro">A card can travel almost anywhere. And sometimes, it can take you elsewhere.</p>
      <p class="context">Emerging from <a class="external" href="https://endsafter.ch" target="_blank" rel="noreferrer">ENDSAFTER ↗</a></p>
    </div>
  </section>
  <section class="section-heading">
    <h2>Recent entries</h2>
    <div class="section-actions">
      <button class="selection-button" type="button" hidden>New selection</button>
      <a href="/archive">View complete archive ({entries.length})</a>
    </div>
  </section>
  <EntryGrid entries={entries.slice(0, 3)} />
  <script define:vars={{ archiveEntries }}>
    const grid = document.querySelector('.entry-grid');
    const selectionButton = document.querySelector('.selection-button');

    if (grid && selectionButton && archiveEntries.length > 3) {
      let currentIds = [];

      const chooseEntries = () => {
        const shuffled = [...archiveEntries];

        for (let index = shuffled.length - 1; index > 0; index -= 1) {
          const randomIndex = Math.floor(Math.random() * (index + 1));
          [shuffled[index], shuffled[randomIndex]] = [shuffled[randomIndex], shuffled[index]];
        }

        const selection = shuffled.slice(0, 3);
        const repeatsCurrentSelection = currentIds.length > 0 &&
          selection.every((entry) => currentIds.includes(entry.id));

        if (repeatsCurrentSelection && shuffled[3]) selection[2] = shuffled[3];
        return selection;
      };

      const createTile = (entry) => {
        const item = document.createElement('li');
        item.className = `entry-tile ${entry.orientation}`;

        const link = document.createElement('a');
        link.className = 'entry-link';
        link.href = `/archive/${entry.id}`;

        const imageContainer = document.createElement('div');
        imageContainer.className = 'entry-image';
        const image = document.createElement('img');
        image.src = entry.image;
        image.alt = `Placeholder image for ${entry.id}`;
        image.loading = 'lazy';
        imageContainer.append(image);

        const metadata = document.createElement('div');
        metadata.className = 'tile-meta';
        const code = document.createElement('span');
        code.className = 'code';
        code.textContent = entry.countryCode;
        const contributor = document.createElement('span');
        contributor.textContent = entry.contributor;
        const archiveId = document.createElement('span');
        archiveId.className = 'archive-id';
        archiveId.textContent = entry.id;
        metadata.append(code, contributor, archiveId);

        link.append(imageContainer, metadata);
        item.append(link);
        return item;
      };

      const showSelection = () => {
        const selection = chooseEntries();
        currentIds = selection.map((entry) => entry.id);
        grid.replaceChildren(...selection.map(createTile));
      };

      selectionButton.hidden = false;
      selectionButton.addEventListener('click', showSelection);
      showSelection();
    }
  </script>
</BaseLayout>
