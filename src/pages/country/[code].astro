---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryGrid from '../../components/EntryGrid.astro';
import { entries } from '../../lib/entries';
export function getStaticPaths() {
  return [...new Set(entries.map((entry) => entry.country.alpha3))].map((code) => ({ params: { code }, props: { code } }));
}
const { code } = Astro.props;
const countryEntries = entries.filter((entry) => entry.country.alpha3 === code);
const country = countryEntries[0].country;
---
<BaseLayout title={country.name}>
  <header class="page-heading"><p class="eyebrow">Country / ISO 3166</p><h1>{country.name}</h1><p class="code">{country.alpha3} {country.numeric} / {countryEntries.length} {countryEntries.length === 1 ? 'entry' : 'entries'}</p></header>
  <EntryGrid entries={countryEntries} />
</BaseLayout>
