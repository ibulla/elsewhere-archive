---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryGrid from '../components/EntryGrid.astro';
import { entries } from '../lib/entries';
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Evolving artwork / archive</p>
    <h1>ELSEWHERE<br /><span>ARCHIVE</span></h1>
    <div class="hero-details">
      <p class="edition">Edition 01 / 2026</p>
      <p class="intro">A growing registry of postcard-sized works, places and associations.</p>
      <p class="context">Emerging from <a class="external" href="https://endsafter.ch" target="_blank" rel="noreferrer">ENDSAFTER ↗</a></p>
    </div>
  </section>
  <section class="section-heading">
    <h2>Recent entries</h2><a href="/archive">View complete archive ({entries.length})</a>
  </section>
  <EntryGrid entries={entries.slice(0, 4)} />
</BaseLayout>
